From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RedeFantasy <dev@redefantasy.com>
Date: Mon, 17 Aug 2026 16:23:41 -0300
Subject: [PATCH] item: avisar quando o servidor gasta unidades de um stack


diff --git a/net/minecraft/world/item/ItemStack.java b/net/minecraft/world/item/ItemStack.java
index f9a0e3fee0b234c9ef9fdcba35a0b64389d01e4b..15ae45797aea5ed83a6a7e1cc3fa40f25231075f 100644
--- a/net/minecraft/world/item/ItemStack.java
+++ b/net/minecraft/world/item/ItemStack.java
@@ -1420,7 +1420,18 @@ public final class ItemStack implements DataComponentHolder, ItemInstance, net.c
 
     public void consume(final int amount, final @Nullable LivingEntity owner) {
         if ((owner == null || !owner.hasInfiniteMaterials())) {
+            // RedeFantasy start - ItemConsumedEvent (fire where the server spends the units, before they go)
+            if (amount > 0 && this != ItemStack.EMPTY && com.redefantasy.server.event.ItemConsumedEvent.getHandlerList().getRegisteredListeners().length > 0) {
+                new com.redefantasy.server.event.ItemConsumedEvent(
+                    owner == null ? null : (org.bukkit.entity.LivingEntity) owner.getBukkitEntity(),
+                    org.bukkit.craftbukkit.inventory.CraftItemStack.asBukkitMirror(this),
+                    amount
+                ).callEvent();
+            }
+            // RedeFantasy end - ItemConsumedEvent
+
             this.shrink(amount);
+
         }
     }
 
