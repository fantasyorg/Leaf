--- a/net/minecraft/world/level/chunk/Strategy.java
+++ b/net/minecraft/world/level/chunk/Strategy.java
@@ -21,6 +21,11 @@ public abstract class Strategy<T> {
     static final Configuration TWO_BITS_LINEAR = new Configuration.Simple(LINEAR_PALETTE_FACTORY, 2);
     static final Configuration THREE_BITS_LINEAR = new Configuration.Simple(LINEAR_PALETTE_FACTORY, 3);
     static final Configuration FOUR_BITS_LINEAR = new Configuration.Simple(LINEAR_PALETTE_FACTORY, 4);
+    // RedeFantasy start - narrow block storage
+    // O bloco serializa sempre em 4 bits; so a copia viva encolhe.
+    private static final Configuration ONE_BIT_LINEAR_NARROW = new Configuration.Narrow(LINEAR_PALETTE_FACTORY, 1, 4);
+    private static final Configuration TWO_BITS_LINEAR_NARROW = new Configuration.Narrow(LINEAR_PALETTE_FACTORY, 2, 4);
+    // RedeFantasy end - narrow block storage
     static final Configuration FIVE_BITS_HASHMAP = new Configuration.Simple(HASHMAP_PALETTE_FACTORY, 5);
     static final Configuration SIX_BITS_HASHMAP = new Configuration.Simple(HASHMAP_PALETTE_FACTORY, 6);
     static final Configuration SEVEN_BITS_HASHMAP = new Configuration.Simple(HASHMAP_PALETTE_FACTORY, 7);
@@ -46,7 +51,8 @@ public abstract class Strategy<T> {
                 return (Configuration)(switch (bits) {
                     case 0 -> Strategy.ZERO_BITS;
                     // Leaf start - Lithium - faster hash palette
-                    case 1, 2 -> Strategy.FOUR_BITS_LINEAR;
+                    case 1 -> Strategy.ONE_BIT_LINEAR_NARROW; // RedeFantasy - narrow block storage
+                    case 2 -> Strategy.TWO_BITS_LINEAR_NARROW; // RedeFantasy - narrow block storage
                     case 3, 4 -> Strategy.HASH_4BIT;
                     case 5 -> Strategy.HASH_5BIT;
                     case 6 -> Strategy.HASH_6BIT;
