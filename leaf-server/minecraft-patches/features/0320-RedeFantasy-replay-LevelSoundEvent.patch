From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RedeFantasy <dev@redefantasy.com>
Date: Tue, 4 Aug 2026 22:58:03 -0300
Subject: [PATCH] RedeFantasy - replay LevelSoundEvent


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 28994a86a2609f5298a84193e54ee89d292cc03f..ba71288526fdf958398b1b2f21e9f48e35ed907b 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1934,6 +1934,7 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
                 serverLevel.replayRecordBlocks = com.redefantasy.server.event.BlockUpdateEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (blocks)
                 serverLevel.replayRecordEntities = com.redefantasy.server.event.EntityMetadataUpdateEvent.getHandlerList().getRegisteredListeners().length > 0 || com.redefantasy.server.event.EntityPositionUpdateEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (entities: metadata + position)
                 serverLevel.replayRecordParticles = com.redefantasy.server.event.LevelParticleEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (particles)
+                serverLevel.replayRecordSounds = com.redefantasy.server.event.LevelSoundEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (sounds)
                 serverLevel.updateLagCompensationTick(); // Paper - lag compensation
                 net.minecraft.world.level.block.entity.HopperBlockEntity.skipHopperEvents = serverLevel.paperConfig().hopper.disableMoveEvent || org.bukkit.event.inventory.InventoryMoveItemEvent.getHandlerList().getRegisteredListeners().length == 0; // Paper - Perf: Optimize Hoppers
                 serverLevel.hasRidableMoveEvent = org.purpurmc.purpur.event.entity.RidableMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Purpur - Ridables
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index e8c4b0b8b4849aa7cd130ed2e06a30bbed4e8586..c1111e56a9aee2fab76dee7e3303188f3dacc989 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -237,6 +237,7 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
     public volatile boolean replayRecordBlocks; // RedeFantasy - replay recording gate (BlockUpdateEvent)
     public volatile boolean replayRecordEntities; // RedeFantasy - replay recording gate (EntityMetadataUpdateEvent)
     public volatile boolean replayRecordParticles; // RedeFantasy - replay recording gate (LevelParticleEvent)
+    public volatile boolean replayRecordSounds; // RedeFantasy - replay recording gate (LevelSoundEvent)
     private final alternate.current.wire.WireHandler wireHandler = new alternate.current.wire.WireHandler(this); // Paper - optimize redstone (Alternate Current)
     public boolean hasRidableMoveEvent = false; // Purpur - Ridables
     final List<ServerPlayer> realPlayers; // Leaves - skip
@@ -2056,6 +2057,11 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
     public void playSeededSound(
         @Nullable Entity entity, double x, double y, double z, Holder<SoundEvent> sound, SoundSource source, float volume, float pitch, long seed
     ) {
+        // RedeFantasy start - replay LevelSoundEvent (root capture of server-sent sounds)
+        if (this.replayRecordSounds) {
+            new com.redefantasy.server.event.LevelSoundEvent(this.getWorld(), sound.value().location().toString(), org.bukkit.SoundCategory.valueOf(source.name()), x, y, z, volume, pitch, seed).callEvent();
+        }
+        // RedeFantasy end - replay LevelSoundEvent
         this.server
             .getPlayerList()
             .broadcast(
@@ -2073,6 +2079,11 @@ public class ServerLevel extends Level implements ServerEntityGetter, WorldGenLe
     public void playSeededSound(
         @Nullable Entity entity, Entity sourceEntity, Holder<SoundEvent> sound, SoundSource source, float volume, float pitch, long seed
     ) {
+        // RedeFantasy start - replay LevelSoundEvent (entity-attached sound, captured at its position)
+        if (this.replayRecordSounds) {
+            new com.redefantasy.server.event.LevelSoundEvent(this.getWorld(), sound.value().location().toString(), org.bukkit.SoundCategory.valueOf(source.name()), sourceEntity.getX(), sourceEntity.getY(), sourceEntity.getZ(), volume, pitch, seed).callEvent();
+        }
+        // RedeFantasy end - replay LevelSoundEvent
         this.server
             .getPlayerList()
             .broadcast(
