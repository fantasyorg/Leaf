From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RedeFantasy <dev@redefantasy.com>
Date: Tue, 4 Aug 2026 22:58:03 -0300
Subject: [PATCH] RedeFantasy - replay LevelSoundEvent


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 2a76aed3b6cc8264c5157aaff53a39673c4d88f1..b30d247f46493a9d3680ac3d743bbd10d01a4c53 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1921,6 +1921,8 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             level.replayRecordBlocks = com.redefantasy.server.event.BlockUpdateEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (blocks)
             level.replayRecordEntities = com.redefantasy.server.event.EntityMetadataUpdateEvent.getHandlerList().getRegisteredListeners().length > 0 || com.redefantasy.server.event.EntityPositionUpdateEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (entities: metadata + position)
             level.replayRecordParticles = com.redefantasy.server.event.LevelParticleEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (particles)
+            level.replayRecordSounds = com.redefantasy.server.event.LevelSoundEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (sounds)
+
 
 
             level.hasRidableMoveEvent = org.purpurmc.purpur.event.entity.RidableMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Purpur - Ridables
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 4b5a42e046aeaa82d5b732e5c1cb50f2f70bb16d..87743e04c1f47afece931660f849c1aca6cf7581 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -244,6 +244,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     public volatile boolean replayRecordBlocks; // RedeFantasy - replay recording gate (BlockUpdateEvent)
     public volatile boolean replayRecordEntities; // RedeFantasy - replay recording gate (EntityMetadataUpdateEvent)
     public volatile boolean replayRecordParticles; // RedeFantasy - replay recording gate (LevelParticleEvent)
+    public volatile boolean replayRecordSounds; // RedeFantasy - replay recording gate (LevelSoundEvent)
     private static final org.bukkit.craftbukkit.persistence.CraftPersistentDataTypeRegistry DATA_TYPE_REGISTRY = new org.bukkit.craftbukkit.persistence.CraftPersistentDataTypeRegistry();
     public final org.bukkit.craftbukkit.persistence.CraftPersistentDataContainer persistentDataContainer = new org.bukkit.craftbukkit.persistence.CraftPersistentDataContainer(DATA_TYPE_REGISTRY);
     private final alternate.current.wire.WireHandler wireHandler = new alternate.current.wire.WireHandler(this); // Paper - optimize redstone (Alternate Current)
@@ -2083,6 +2084,11 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         final float pitch,
         final long seed
     ) {
+        // RedeFantasy start - replay LevelSoundEvent (root capture of server-sent sounds)
+        if (this.replayRecordSounds) {
+            new com.redefantasy.server.event.LevelSoundEvent(this.getWorld(), sound.value().location().toString(), org.bukkit.SoundCategory.valueOf(source.name()), x, y, z, volume, pitch, seed).callEvent();
+        }
+        // RedeFantasy end - replay LevelSoundEvent
         this.server
             .getPlayerList()
             .broadcast(
@@ -2106,11 +2112,17 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
         final float pitch,
         final long seed
     ) {
+        // RedeFantasy start - replay LevelSoundEvent (entity-attached sound, captured at its position)
+        if (this.replayRecordSounds) {
+            new com.redefantasy.server.event.LevelSoundEvent(this.getWorld(), sound.value().location().toString(), org.bukkit.SoundCategory.valueOf(source.name()), sourceEntity.getX(), sourceEntity.getY(), sourceEntity.getZ(), volume, pitch, seed).callEvent();
+        }
+        // RedeFantasy end - replay LevelSoundEvent
         this.server
             .getPlayerList()
             .broadcast(
                 except instanceof Player player ? player : null,
                 sourceEntity.getX(),
+
                 sourceEntity.getY(),
                 sourceEntity.getZ(),
                 sound.value().getRange(volume),
