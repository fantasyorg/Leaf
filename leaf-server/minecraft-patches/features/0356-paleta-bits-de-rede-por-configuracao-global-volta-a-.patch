         /** A copia viva pode ser mais estreita que o formato de fio; quem sai na rede e esta. */
         private BitStorage storageForWire() {
-            final int bits = this.configuration.bitsInStorage();
+            final int bits = this.configuration.bitsOnWire();
             final BitStorage storage = this.storage;
 
             if (storage.getBits() == bits) {
@@ -508,7 +508,7 @@ public class PalettedContainer<T> implements PaletteResize<T>, PalettedContainer
         }
 
         private int serializedLongCount() {
-            final int bits = this.configuration.bitsInStorage();
+            final int bits = this.configuration.bitsOnWire();
 
             if (this.storage.getBits() == bits) {
                 return this.storage.getRaw().length;
