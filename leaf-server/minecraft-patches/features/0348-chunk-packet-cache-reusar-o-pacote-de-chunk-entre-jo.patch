@@ -81,7 +81,14 @@ public class PlayerChunkSender {
     public static void sendChunk(ServerGamePacketListenerImpl packetListener, ServerLevel level, LevelChunk chunk) { // Paper - rewrite chunk system - public
         // Paper start - Anti-Xray
         final boolean shouldModify = level.chunkPacketBlockController.shouldModify(packetListener.player, chunk);
+        // Leaf start - chunk packet cache
+        final org.dreeam.leaf.async.chunk.ChunkPacketCache cache = shouldModify ? null : org.dreeam.leaf.async.chunk.ChunkPacketCache.of(level);
+        if (cache != null) {
+            packetListener.send(cache.get(chunk.locX, chunk.locZ, () -> new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, false)));
+        } else {
         packetListener.send(new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, shouldModify));
+        }
+        // Leaf end - chunk packet cache
         // Paper end - Anti-Xray
         // Paper start - PlayerChunkLoadEvent
         if (io.papermc.paper.event.packet.PlayerChunkLoadEvent.getHandlerList().getRegisteredListeners().length > 0) {
@@ -99,6 +106,17 @@ public class PlayerChunkSender {
     // Leaf start - async chunk sender
     public static void sendChunk(ServerGamePacketListenerImpl packetListener, ServerLevel level, LevelChunk chunk, org.dreeam.leaf.async.chunk.AsyncChunkSender chunkSender) {
         final boolean shouldModify = level.chunkPacketBlockController.shouldModify(packetListener.player, chunk);
+        // Leaf start - chunk packet cache
+        final org.dreeam.leaf.async.chunk.ChunkPacketCache cache = shouldModify ? null : org.dreeam.leaf.async.chunk.ChunkPacketCache.of(level);
+        if (cache != null) {
+            // O cache resolve na hora quando ja tem o pacote; so o primeiro envio de cada chunk vai pro pool.
+            final ClientboundLevelChunkWithLightPacket cached = cache.peek(chunk.locX, chunk.locZ);
+            if (cached != null) {
+                chunkSender.submit(() -> cached);
+                return;
+            }
+        }
+        // Leaf end - chunk packet cache
         net.minecraft.world.level.block.entity.BlockEntity[] blockEntities = chunk.blockEntities.values().toArray(new net.minecraft.world.level.block.entity.BlockEntity[0]);
         java.util.Map<net.minecraft.world.level.levelgen.Heightmap.Types, long[]> heightmaps = new java.util.EnumMap<>(net.minecraft.world.level.levelgen.Heightmap.Types.class);
         for (java.util.Map.Entry<net.minecraft.world.level.levelgen.Heightmap.Types, net.minecraft.world.level.levelgen.Heightmap> entry1 : chunk.getHeightmaps()) {
@@ -107,7 +125,14 @@ public class PlayerChunkSender {
             }
         }
         chunkSender.submit(
-            () -> new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, shouldModify, blockEntities, heightmaps)
+            () -> {
+                // Leaf start - chunk packet cache
+                if (cache != null) {
+                    return cache.get(chunk.locX, chunk.locZ, () -> new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, false, blockEntities, heightmaps));
+                }
+                // Leaf end - chunk packet cache
+                return new ClientboundLevelChunkWithLightPacket(chunk, level.getLightEngine(), null, null, shouldModify, blockEntities, heightmaps);
+            }
         );
     }
     // Leaf end - async chunk sender
