         try {
+            // Leaf start - Proxy tunnel: on the game port unless a port of its own is configured
+            boolean tunnel = org.dreeam.leaf.config.modules.network.ProxyTunnel.enabled && bindAddress instanceof java.net.InetSocketAddress && !io.papermc.paper.configuration.GlobalConfiguration.get().proxies.proxyProtocol;
+            if (tunnel && org.dreeam.leaf.config.modules.network.ProxyTunnel.port <= 0) {
+                this.getConnection().enableTunnelOnGamePort();
+            }
+            // Leaf end - Proxy tunnel
             this.getConnection().startTcpServerListener(bindAddress); // Paper - Unix domain socket support
+            // Leaf start - Proxy tunnel
+            if (tunnel && org.dreeam.leaf.config.modules.network.ProxyTunnel.port > 0) {
+                this.getConnection().startTunnelListener((java.net.InetSocketAddress) bindAddress, org.dreeam.leaf.config.modules.network.ProxyTunnel.port);
+            }
+            // Leaf end - Proxy tunnel
         } catch (IOException var11) {
             LOGGER.warn("**** FAILED TO BIND TO PORT!");
             LOGGER.warn("The exception was: {}", var11.toString());
