+    /** Reads the tunnel secret once; null (and a log line) when the tunnel cannot run. */
+    private byte @Nullable [] tunnelSecret() {
+        String secret = io.papermc.paper.configuration.GlobalConfiguration.get().proxies.velocity.secret;
+
+        if (secret == null || secret.isEmpty()) {
+            LOGGER.error("The proxy tunnel needs the Velocity forwarding secret to authenticate the proxy; tunnel disabled.");
+            return null;
+        }
+
+        return org.dreeam.leaf.network.tunnel.TunnelProtocol.secretBytes(secret);
+    }
