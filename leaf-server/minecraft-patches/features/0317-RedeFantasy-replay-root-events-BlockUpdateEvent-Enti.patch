From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RedeFantasy <dev@redefantasy.com>
Date: Tue, 4 Aug 2026 16:33:37 -0300
Subject: [PATCH] RedeFantasy - replay root events (BlockUpdateEvent /
 EntityMetadataUpdateEvent)


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 1762520cf455b304a3f34aec73d46bdf1dd3ca67..6070abfb66a751220e9d23b57fa464a5721b8fb4 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1918,6 +1918,8 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
         for (ServerLevel level : this.getAllLevels()) {
             level.hasPhysicsEvent = org.bukkit.event.block.BlockPhysicsEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - BlockPhysicsEvent
             level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
+            level.replayRecordBlocks = com.redefantasy.server.event.BlockUpdateEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (blocks)
+            level.replayRecordEntities = com.redefantasy.server.event.EntityMetadataUpdateEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (entities)
             level.hasRidableMoveEvent = org.purpurmc.purpur.event.entity.RidableMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Purpur - Ridables
             level.updateLagCompensationTick(); // Paper - lag compensation
             net.minecraft.world.level.block.entity.HopperBlockEntity.skipHopperEvents = level.paperConfig().hopper.disableMoveEvent || org.bukkit.event.inventory.InventoryMoveItemEvent.getHandlerList().getRegisteredListeners().length == 0; // Paper - Perf: Optimize Hoppers
diff --git a/net/minecraft/server/level/ServerEntity.java b/net/minecraft/server/level/ServerEntity.java
index edad1bd673c5913e2339cfa830b6684e21b091e2..4032632a8968b61a2fcef5cd75b7784b79446288 100644
--- a/net/minecraft/server/level/ServerEntity.java
+++ b/net/minecraft/server/level/ServerEntity.java
@@ -460,6 +460,11 @@ public class ServerEntity {
         if (packedValues != null) {
             this.trackedDataValues = entityData.getNonDefaultValues();
             this.synchronizer.sendToTrackingPlayersAndSelf(new ClientboundSetEntityDataPacket(this.entity.getId(), packedValues));
+            // RedeFantasy start - replay EntityMetadataUpdateEvent (non-async tracker / Citizens path; main thread)
+            if (this.entity.level() instanceof ServerLevel replayLevel && replayLevel.replayRecordEntities) {
+                new com.redefantasy.server.event.EntityMetadataUpdateEvent(this.entity.getBukkitEntity()).callEvent();
+            }
+            // RedeFantasy end - replay EntityMetadataUpdateEvent
         }
         // Leaf - Multithreaded tracker - diff on change
 
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index 7c73f5373d741c5703fff7f5e6eb66d6916b6d8f..464d07098a4e4d97b5be4b9fa61c2b71f7e7f9dc 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -241,6 +241,8 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     private @Nullable ServerClockManager clockManager;
     public boolean hasPhysicsEvent = true; // Paper - BlockPhysicsEvent
     public boolean hasEntityMoveEvent; // Paper - Add EntityMoveEvent
+    public volatile boolean replayRecordBlocks; // RedeFantasy - replay recording gate (BlockUpdateEvent)
+    public volatile boolean replayRecordEntities; // RedeFantasy - replay recording gate (EntityMetadataUpdateEvent)
     private static final org.bukkit.craftbukkit.persistence.CraftPersistentDataTypeRegistry DATA_TYPE_REGISTRY = new org.bukkit.craftbukkit.persistence.CraftPersistentDataTypeRegistry();
     public final org.bukkit.craftbukkit.persistence.CraftPersistentDataContainer persistentDataContainer = new org.bukkit.craftbukkit.persistence.CraftPersistentDataContainer(DATA_TYPE_REGISTRY);
     private final alternate.current.wire.WireHandler wireHandler = new alternate.current.wire.WireHandler(this); // Paper - optimize redstone (Alternate Current)
diff --git a/net/minecraft/world/level/chunk/LevelChunk.java b/net/minecraft/world/level/chunk/LevelChunk.java
index 9851a60140f9989fbac317db200d8484d43ee16c..49fb61cf5e689daad69764029112a796c94a4b9b 100644
--- a/net/minecraft/world/level/chunk/LevelChunk.java
+++ b/net/minecraft/world/level/chunk/LevelChunk.java
@@ -529,6 +529,16 @@ public class LevelChunk extends ChunkAccess implements DebugValueSource, ca.spot
             }
         }
 
+        // RedeFantasy start - replay BlockUpdateEvent (fire at the single committed-write choke point)
+        if (this.level instanceof ServerLevel replayLevel && replayLevel.replayRecordBlocks && !replayLevel.captureBlockStates) {
+            new com.redefantasy.server.event.BlockUpdateEvent(
+                org.bukkit.craftbukkit.block.CraftBlock.at(replayLevel, pos),
+                oldState.asBlockData(),
+                state.asBlockData()
+            ).callEvent();
+        }
+        // RedeFantasy end - replay BlockUpdateEvent
+
         this.markUnsaved();
         return oldState;
     }
