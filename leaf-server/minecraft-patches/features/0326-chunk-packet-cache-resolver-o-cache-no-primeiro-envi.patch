From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Paschoal Bergamo <64669985+felipepasc@users.noreply.github.com>
Date: Sat, 29 Aug 2026 02:23:55 -0300
Subject: [PATCH] chunk packet cache: resolver o cache no primeiro envio, nao
 no construtor do level

No construtor do ServerLevel o mundo ainda nao tem nome (serverLevelData e
nulo), e a config decide por nome de mundo: inicializar ali derrubava o boot.

diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index ea9db664f034e1a6813e358270d333ce4d01633c..a72c77d605e6c866c03127f2e7b3c9428bf8a16b 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -250,7 +250,12 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     private final alternate.current.wire.WireHandler wireHandler = new alternate.current.wire.WireHandler(this); // Paper - optimize redstone (Alternate Current)
     public boolean hasRidableMoveEvent = false; // Purpur - Ridables
     public final org.dreeam.leaf.async.tracker.AsyncTracker leaf$asyncTracker = new org.dreeam.leaf.async.tracker.AsyncTracker(); // Leaf - Multithreaded tracker
-    public final org.dreeam.leaf.async.chunk.@org.jspecify.annotations.Nullable ChunkPacketCache leaf$chunkPacketCache = org.dreeam.leaf.async.chunk.ChunkPacketCache.create(this); // Leaf - chunk packet cache
+    // Leaf start - chunk packet cache
+    // Resolvido no primeiro envio de chunk (ChunkPacketCache.of): aqui o mundo ainda nao tem nome.
+    public org.dreeam.leaf.async.chunk.@org.jspecify.annotations.Nullable ChunkPacketCache leaf$chunkPacketCache;
+    public boolean leaf$chunkPacketCacheResolved;
+    // Leaf end - chunk packet cache
+
     private @Nullable WorldBorder worldBorder; // Leaf - Cache world border
 
     @Override
