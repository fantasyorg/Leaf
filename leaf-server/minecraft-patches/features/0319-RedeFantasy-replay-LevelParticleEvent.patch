From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RedeFantasy <dev@redefantasy.com>
Date: Tue, 4 Aug 2026 22:40:23 -0300
Subject: [PATCH] RedeFantasy - replay LevelParticleEvent


diff --git a/net/minecraft/server/MinecraftServer.java b/net/minecraft/server/MinecraftServer.java
index 09b5fdf0e24555ae8068c4dd02631b9c1ca71a1f..2a76aed3b6cc8264c5157aaff53a39673c4d88f1 100644
--- a/net/minecraft/server/MinecraftServer.java
+++ b/net/minecraft/server/MinecraftServer.java
@@ -1920,6 +1920,8 @@ public abstract class MinecraftServer extends ReentrantBlockableEventLoop<TickTa
             level.hasEntityMoveEvent = io.papermc.paper.event.entity.EntityMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Paper - Add EntityMoveEvent
             level.replayRecordBlocks = com.redefantasy.server.event.BlockUpdateEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (blocks)
             level.replayRecordEntities = com.redefantasy.server.event.EntityMetadataUpdateEvent.getHandlerList().getRegisteredListeners().length > 0 || com.redefantasy.server.event.EntityPositionUpdateEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (entities: metadata + position)
+            level.replayRecordParticles = com.redefantasy.server.event.LevelParticleEvent.getHandlerList().getRegisteredListeners().length > 0; // RedeFantasy - replay recording gate (particles)
+
 
             level.hasRidableMoveEvent = org.purpurmc.purpur.event.entity.RidableMoveEvent.getHandlerList().getRegisteredListeners().length > 0; // Purpur - Ridables
             level.updateLagCompensationTick(); // Paper - lag compensation
diff --git a/net/minecraft/server/level/ServerLevel.java b/net/minecraft/server/level/ServerLevel.java
index b6b87a7e090b8df1f34d12a9e32d427fd6c35c86..4b5a42e046aeaa82d5b732e5c1cb50f2f70bb16d 100644
--- a/net/minecraft/server/level/ServerLevel.java
+++ b/net/minecraft/server/level/ServerLevel.java
@@ -243,6 +243,7 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
     public boolean hasEntityMoveEvent; // Paper - Add EntityMoveEvent
     public volatile boolean replayRecordBlocks; // RedeFantasy - replay recording gate (BlockUpdateEvent)
     public volatile boolean replayRecordEntities; // RedeFantasy - replay recording gate (EntityMetadataUpdateEvent)
+    public volatile boolean replayRecordParticles; // RedeFantasy - replay recording gate (LevelParticleEvent)
     private static final org.bukkit.craftbukkit.persistence.CraftPersistentDataTypeRegistry DATA_TYPE_REGISTRY = new org.bukkit.craftbukkit.persistence.CraftPersistentDataTypeRegistry();
     public final org.bukkit.craftbukkit.persistence.CraftPersistentDataContainer persistentDataContainer = new org.bukkit.craftbukkit.persistence.CraftPersistentDataContainer(DATA_TYPE_REGISTRY);
     private final alternate.current.wire.WireHandler wireHandler = new alternate.current.wire.WireHandler(this); // Paper - optimize redstone (Alternate Current)
@@ -2741,8 +2742,22 @@ public class ServerLevel extends Level implements WorldGenLevel, ServerEntityGet
             count,
             randomizationType
         );
+        // RedeFantasy start - replay LevelParticleEvent (root capture of server-sent particles, type + data)
+        if (this.replayRecordParticles) {
+            net.minecraft.network.RegistryFriendlyByteBuf replayBuffer = new net.minecraft.network.RegistryFriendlyByteBuf(io.netty.buffer.Unpooled.buffer(), this.registryAccess());
+            try {
+                net.minecraft.core.particles.ParticleTypes.STREAM_CODEC.encode(replayBuffer, particle);
+                byte[] replayParticle = new byte[replayBuffer.readableBytes()];
+                replayBuffer.readBytes(replayParticle);
+                new com.redefantasy.server.event.LevelParticleEvent(this.getWorld(), replayParticle, x, y, z, count, xDist, yDist, zDist, xSpeed).callEvent();
+            } finally {
+                replayBuffer.release();
+            }
+        }
+        // RedeFantasy end - replay LevelParticleEvent
         int result = 0;
 
+
         for (int i = 0; i < receivers.size(); i++) { // Paper - particle API
             ServerPlayer player = receivers.get(i); // Paper - particle API
             if (sender != null && !player.getBukkitEntity().canSee(sender.getBukkitEntity())) continue; // CraftBukkit // Leaf - Remove stream in CraftWorld#spawnParticle - diff on change
