--- a/net/minecraft/server/level/ChunkHolder.java
+++ b/net/minecraft/server/level/ChunkHolder.java
@@ -221,6 +221,7 @@ public class ChunkHolder extends GenerationChunkHolder implements ca.spottedleaf
     }
 
     public boolean blockChanged(final BlockPos pos) {
+        this.leaf$invalidateCachedPacket(); // Leaf - chunk packet cache
         LevelChunk chunk = this.playersSentChunkTo.size() == 0 ? null : this.getChunkToSend(); // Paper - rewrite chunk system
         if (chunk == null) {
             return false;
@@ -240,7 +241,21 @@ public class ChunkHolder extends GenerationChunkHolder implements ca.spottedleaf
         return !hadChangedSections;
     }
 
+    // Leaf start - chunk packet cache
+    /** Bloco, luz ou block entity mudaram: o pacote guardado deste chunk nao descreve mais o mundo. */
+    private void leaf$invalidateCachedPacket() {
+        if (this.levelHeightAccessor instanceof ServerLevel serverLevel) {
+            final org.dreeam.leaf.async.chunk.ChunkPacketCache cache = org.dreeam.leaf.async.chunk.ChunkPacketCache.of(serverLevel);
+            if (cache != null) {
+                cache.invalidate(this.pos.x(), this.pos.z());
+            }
+        }
+    }
+    // Leaf end - chunk packet cache
+
     public boolean sectionLightChanged(final LightLayer layer, final int chunkY) {
+        this.leaf$invalidateCachedPacket(); // Leaf - chunk packet cache
+
         ChunkAccess chunk = this.getChunkIfPresent(ChunkStatus.INITIALIZE_LIGHT);
         if (chunk == null) {
             return false;
