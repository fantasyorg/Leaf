+    // RedeFantasy start - constant light
+    /** Identifica no heap dump qual build de luz constante esta rodando. */
+    public static final String CONSTANT_LIGHT_BUILD_TAG = "RedeFantasy-constant-light-guards-v11-serializable";
+
+    private static final DataLayer[] CONSTANT_LIGHT_LAYERS = new DataLayer[16];
+    static {
+        for (int level = 0; level < CONSTANT_LIGHT_LAYERS.length; ++level) {
+            final DataLayer layer = new DataLayer(level);
+            if (level != 0) {
+                // materializa o array uma vez; ele e compartilhado por todas as secoes e so pode ser lido
+                layer.getData();
+            }
+            CONSTANT_LIGHT_LAYERS[level] = layer;
+        }
+    }
+
+    /**
+     * Luz fixa deste mundo, ou {@code null} quando a luz e a calculada pelo motor. Lida a cada
+     * chamada para acompanhar reload de config e para nao depender da ordem de construcao do mundo.
+     */
+    private io.papermc.paper.configuration.WorldConfiguration.ConstantLight constantLight() {
+        if (this.world == null || this.isClientSide) {
+            return null;
+        }
+
+        final io.papermc.paper.configuration.WorldConfiguration paperConfig = this.world.paperConfig();
+        if (paperConfig == null || paperConfig.constantLight == null || !paperConfig.constantLight.enabled) {
+            return null;
+        }
+
+        return paperConfig.constantLight;
+    }
+
+    private static int clampLightLevel(final int level) {
+        return Math.max(0, Math.min(15, level));
+    }
+    // RedeFantasy end - constant light
+
