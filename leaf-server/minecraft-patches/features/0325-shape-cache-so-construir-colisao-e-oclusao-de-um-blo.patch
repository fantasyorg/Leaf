+        // RedeFantasy start - shape cache sob demanda
+        // O path type consulta colisão de todo state — este loop materializaria os shape caches
+        // inteiros de volta. Sob demanda, quem calcula é o WalkNodeEvaluator no primeiro pathfind
+        // que tocar o state (sentinela -1).
+        if (net.minecraft.world.level.block.state.BlockBehaviour.BlockStateBase.LAZY_SHAPE_CACHE) return;
+        // RedeFantasy end - shape cache sob demanda
         for (Block block : BuiltInRegistries.BLOCK) {
             for (BlockState blockState : block.getStateDefinition().getPossibleStates()) {
                 blockState.initPathType();
