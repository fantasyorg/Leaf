         protected boolean shapeExceedsCube = true; // Paper - moved from actual method to here
+        // RedeFantasy start - shape cache sob demanda
+        // O boot vanilla materializa colisão, oclusão e o aquecimento do Moonrise pra TODO block
+        // state do jogo — dezenas de MB que a maioria dos servidores nunca consulta por inteiro, e
+        // que um servidor de void (limbo, auth) não consulta quase nada. A cauda pesada do
+        // initCache só constrói quando alguém pergunta pelo shape daquele state.
+        // -Dleaf.lazyBlockStateCache=false volta o boot eager do vanilla sem rebuild.
+        public static final boolean LAZY_SHAPE_CACHE = Boolean.parseBoolean(System.getProperty("leaf.lazyBlockStateCache", "true"));
+        private volatile boolean shapeCachesReady;
+        // O build pode reentrar nos leitores do próprio state (Cache/propagatesSkylightDown passam
+        // por eles); a guarda devolve o leitor pro fallback de cache nulo, como no vanilla durante
+        // o initCache.
+        private boolean buildingShapeCaches;
+
+        private void ensureShapeCaches() {
+            if (this.shapeCachesReady) return;
+
+            synchronized (this) {
+                if (this.shapeCachesReady || this.buildingShapeCaches) return;
+
+                this.buildingShapeCaches = true;
+                try {
+                    this.buildShapeCaches();
+                } finally {
+                    this.buildingShapeCaches = false;
+                }
+                this.shapeCachesReady = true;
+            }
+        }
+        // RedeFantasy end - shape cache sob demanda
+
         public void initCache() {
             this.fluidState = this.owner.getFluidState(this.asState());
             this.isRandomlyTicking = this.owner.isRandomlyTicking(this.asState());
+            // Paper start - rewrite chunk system
+            this.isConditionallyFullOpaque = this.canOcclude & this.useShapeForLightOcclusion;
+            // Paper end - rewrite chunk system
+            // RedeFantasy start - shape cache sob demanda
+            if (LAZY_SHAPE_CACHE) return;
+
+            this.buildShapeCaches();
+            this.shapeCachesReady = true;
+        }
+
+        private void buildShapeCaches() {
+            // RedeFantasy end - shape cache sob demanda
             if (!this.getBlock().hasDynamicShape()) {
                 this.cache = new BlockBehaviour.BlockStateBase.Cache(this.asState());
             }
@@ -603,9 +650,7 @@ public abstract class BlockBehaviour implements FeatureElement, net.caffeinemc.m
 
             this.propagatesSkylightDown = this.owner.propagatesSkylightDown(this.asState());
             this.lightBlock = this.owner.getLightBlock(this.asState());
-            // Paper start - rewrite chunk system
