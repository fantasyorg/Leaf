From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: RedeFantasy <dev@redefantasy.com>
Date: Mon, 17 Aug 2026 15:56:40 -0300
Subject: [PATCH] criativo: avisar quando o servidor duplica um stack, no ponto
 da copia


diff --git a/net/minecraft/world/inventory/AbstractContainerMenu.java b/net/minecraft/world/inventory/AbstractContainerMenu.java
index e02184d0d52e04b35c4fb3534027bef3e1276cbc..485ef34702b7251103145a9a6ffd81de7a7fa5c7 100644
--- a/net/minecraft/world/inventory/AbstractContainerMenu.java
+++ b/net/minecraft/world/inventory/AbstractContainerMenu.java
@@ -628,7 +628,25 @@ public abstract class AbstractContainerMenu {
             Slot slot2 = this.slots.get(slotIndex);
             if (slot2.hasItem()) {
                 ItemStack itemStack = slot2.getItem();
-                this.setCarried(itemStack.copyWithCount(itemStack.getMaxStackSize()));
+                // RedeFantasy start - CreativeItemCloneEvent (fire where the copy is made, before the cursor gets it)
+                ItemStack cloned = itemStack.copyWithCount(itemStack.getMaxStackSize());
+
+                if (com.redefantasy.server.event.CreativeItemCloneEvent.getHandlerList().getRegisteredListeners().length > 0 && player.getBukkitEntity() instanceof org.bukkit.entity.Player bukkitPlayer) {
+                    com.redefantasy.server.event.CreativeItemCloneEvent cloneEvent = new com.redefantasy.server.event.CreativeItemCloneEvent(
+                        bukkitPlayer,
+                        org.bukkit.craftbukkit.inventory.CraftItemStack.asCraftMirror(itemStack),
+                        org.bukkit.craftbukkit.inventory.CraftItemStack.asCraftMirror(cloned)
+                    );
+
+                    if (!cloneEvent.callEvent()) {
+                        return;
+                    }
+
+                    cloned = org.bukkit.craftbukkit.inventory.CraftItemStack.asNMSCopy(cloneEvent.getClone());
+                }
+
+                this.setCarried(cloned);
+                // RedeFantasy end - CreativeItemCloneEvent
             }
         } else if (clickType == ClickType.THROW && this.getCarried().isEmpty() && slotIndex >= 0) {
             Slot slot2 = this.slots.get(slotIndex);
