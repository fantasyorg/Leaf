From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Felipe Paschoal Bergamo <64669985+felipepasc@users.noreply.github.com>
Date: Sat, 29 Aug 2026 02:42:20 -0300
Subject: [PATCH] lazy container broadcast: GUI de plugin suja o menu de quem a
 ve


diff --git a/src/main/java/org/bukkit/craftbukkit/inventory/CraftInventoryCustom.java b/src/main/java/org/bukkit/craftbukkit/inventory/CraftInventoryCustom.java
index 680468e6c16f1015d3b3b999e61a7d322ea03561..c24dde06124f943f8419e61e5ccee6ae2f7c536a 100644
--- a/src/main/java/org/bukkit/craftbukkit/inventory/CraftInventoryCustom.java
+++ b/src/main/java/org/bukkit/craftbukkit/inventory/CraftInventoryCustom.java
@@ -160,6 +160,7 @@ public class CraftInventoryCustom extends CraftInventory {
             if (stack != ItemStack.EMPTY && this.getMaxStackSize() > 0 && stack.getCount() > this.getMaxStackSize()) {
                 stack.setCount(this.getMaxStackSize());
             }
+            this.leaf$markViewersDirty(); // Leaf - lazy container broadcast; GUI de plugin escreve por aqui, sem setChanged
         }
 
         @Override
@@ -173,7 +174,9 @@ public class CraftInventoryCustom extends CraftInventory {
         }
 
         @Override
-        public void setChanged() {}
+        public void setChanged() {
+            this.leaf$markViewersDirty(); // Leaf - lazy container broadcast
+        }
 
         @Override
         public boolean stillValid(Player player) {
